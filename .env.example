# ==========================================
# Copy to .env at the repository root.
# ==========================================

DB_NAME=webhook_data
DB_USER=webhook_user
DB_PASSWORD=replace-with-a-local-database-password
DB_PUBLISHED_PORT=5433

# Docker Desktop + GitLab on this host's port 80: http://host.docker.internal/api/v4
GITLAB_API_URL=https://gitlab.example.com/api/v4
GITLAB_PRIVATE_TOKEN=replace-with-a-read-api-token
GITLAB_WEBHOOK_SECRET=replace-with-a-separate-random-webhook-secret
GITLAB_REQUEST_TIMEOUT=30

# Use 0.0.0.0 when GitLab connects through the host network (see README.md#network-addresses).
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PUBLISHED_PORT=5001
FRONTEND_PUBLISHED_PORT=8050

# Optional bundled GitLab: README.md#option-b-use-the-bundled-gitlab. Change ports if already in use.
GITLAB_IMAGE=gitlab/gitlab-ce:19.4.1-ce.0
GITLAB_HTTP_PORT=8080
GITLAB_SSH_PORT=2222
